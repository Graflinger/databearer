# Azure FLUX image generation — copy to .env and fill in
# Get the key from the Azure portal (rotate if it was ever exposed).
IMAGE_OUTPUT_DIR=../generated-images

IMAGE_GENERATION_ENDPOINT_URL=https://demofoundrygraflinger.services.ai.azure.com/models
IMAGE_GENERATION_PROVIDER=azure_foundry_images
IMAGE_GENERATION_MODEL=MAI-Image-2.5
IMAGE_GENERATION_HEADER_NAME=api-key
IMAGE_GENERATION_KEY=<your new key>
