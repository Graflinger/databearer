/data/history/german-electricity/manifest.json
  Cache-Control: no-cache

/data/history/german-electricity/:year.:sha.json
  Cache-Control: public, max-age=31536000, immutable

# Responsive image variants carry a content hash in their filenames.
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/search.json
  X-Robots-Tag: noindex

# Machine-readable index for LLM tools; the listed HTML pages are the indexable copies.
/llms.txt
  X-Robots-Tag: noindex

/suche/
  X-Robots-Tag: noindex, follow

# Pretty URLs 308-redirect /404.html to /404. Not-found responses on arbitrary
# paths cannot match a path rule; the page's robots meta (noindex) covers them.
/404
  X-Robots-Tag: noindex, follow

# The production *.pages.dev alias duplicates the custom domain. Cloudflare adds
# noindex to preview deployments only, so both aliases are set here explicitly.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
