---
permalink: /search.json
excludeFromSitemap: true
eleventyExcludeFromCollections: true
---
{%- set searchItems = [] -%}
{%- for item in (collections.post or []).concat(collections.dashboard or []) -%}
  {%- if item.url and (item | published) and not item.data.noindex -%}
    {%- set searchItems = searchItems.concat([item]) -%}
  {%- endif -%}
{%- endfor -%}
[
{%- for item in searchItems | reverse -%}
  {
    "title": {{ item.data.title | dump | safe }},
    "url": {{ item.url | dump | safe }},
    "excerpt": {{ (item.data.excerpt or item.data.dashboardSummary or item.data.description or '') | dump | safe }},
    "date": {% if item.data.date %}{{ item.data.date | htmlDateString | dump | safe }}{% else %}null{% endif %},
    "topic": {{ (item.data.topic or [item.data.dashboardTopic or '']) | dump | safe }},
    "image": {{ (item.data.image or item.data.dashboardImage or '') | dump | safe }},
    "content": {{ (item.data.dashboardSummary or item.templateContent or '') | striptags | dump | safe }}
  }{%- if not loop.last -%},{%- endif -%}
{%- endfor -%}
]
